{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/schemas/stryker-config.json",
  "stryker-config": {
    "project": "IndFusion.Ember.csproj",
    "test-projects": [
      "../IndFusion.Ember.Tests/IndFusion.Ember.Tests.csproj"
    ],
    "test-runner": "mtp",
    "mutate": [
      "**/*.cs"
    ],
    "ignore-mutations": [],
    "ignore-methods": [],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "coverage-analysis": "perTest",
    "verbosity": "info",
    "concurrency": 4,
    "additional-timeout": 10000,
    "break-on-initial-test-failure": true,
    "reporters": [
      "html",
      "progress",
      "json"
    ]
  }
}
